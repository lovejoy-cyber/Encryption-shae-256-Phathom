{
  "name": "@phantomvault/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "oxlint src test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@node-rs/argon2": "^2.0.2",
    "@phantomvault/crypto-core": "*",
    "@simplewebauthn/server": "^13.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.9.1",
    "jose": "^6.1.0",
    "otplib": "^13.5.0",
    "pino": "^10.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "drizzle-kit": "^0.31.10",
    "nid-webauthn-emulator": "^0.2.15",
    "oxlint": "^1.79.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
